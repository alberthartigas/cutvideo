<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- El WebView (WKWebView) compila JavaScript en tiempo de ejecución. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Los sidecars ffmpeg/ffprobe enlazan librerías que no firmamos nosotros
       (en desarrollo, las de Homebrew). Sin esto, el runtime endurecido los mata. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Nota: aquí había un `com.apple.security.inherit`, puesto pensando que
       hacía falta para lanzar los sidecars. No es eso: ese permiso es para que
       un proceso hijo herede el sandbox del padre, y al ponerlo en una app que
       no está en sandbox macOS la metía en uno heredado y vacío, sin red. Por
       eso fallaban Openverse, la comprobación de derechos y la IA. Una app con
       Developer ID fuera de la App Store no debe llevarlo. -->
</dict>
</plist>
