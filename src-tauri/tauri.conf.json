{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CutVideo",
  "version": "0.1.10",
  "identifier": "com.alberthartigas.cutvideo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "CutVideo",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$VIDEO/**",
          "$DOWNLOAD/**",
          "$DESKTOP/**",
          "$DOCUMENT/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "macOS": {
      "minimumSystemVersion": "26.0",
      "signingIdentity": "Developer ID Application: alberth Artigas (86YZGR88FV)",
      "entitlements": "entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/sfx/*.mp3"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENERTUwQjI3OUJBMUJCNTIKUldSU3U2R2JKd3ZsemF6aklWQ2N3bEhUSXhldlJFbEJhLzZRMlJrR3ovZHB5cHpqTkYxb0xCVkoK",
      "endpoints": [
        "https://github.com/alberthartigas/cutvideo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
