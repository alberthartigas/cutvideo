node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Sidecars de FFmpeg (se generan con scripts/setup-ffmpeg.sh)
/src-tauri/binaries/

# Medios de prueba para el modo navegador (npm run dev sin Tauri)
/static/dev-media/

# Copia de los efectos para el modo navegador (los buenos están en src-tauri/resources)
